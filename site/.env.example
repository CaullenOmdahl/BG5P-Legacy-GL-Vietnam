# Required for /api/chat in production and local chat testing.
MINIMAX_API_KEY=

# Optional MiniMax settings.
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_MODEL=MiniMax-M2.7-highspeed
MINIMAX_MAX_TOKENS=1800
MINIMAX_TEMPERATURE=1
MINIMAX_TOP_P=0.95

# Optional trusted-proxy settings for /api/chat rate-limit identity.
# The proxy must set x-bg5-trusted-proxy to this exact secret before the app
# will honor forwarded client IP headers.
BG5_TRUSTED_PROXY_SECRET=
BG5_CLIENT_IP_HEADER=x-forwarded-for

# Optional server secret for signed fallback chat rate-limit session cookies.
# If unset, the app falls back to BG5_TRUSTED_PROXY_SECRET or MINIMAX_API_KEY.
BG5_RATE_LIMIT_SECRET=

# Optional generator/verification override for public bg5.caphedigital.com URLs.
BG5_SITE_BASE_URL=https://bg5.caphedigital.com
